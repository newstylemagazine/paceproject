# Copy this file to .env and add an API key from ONE of the providers below.
# The site still runs without any key, but AI responses will use fallback mode.

# --- Groq (recommended: free, no credit card required) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI (optional alternative, paid) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

PORT=8000
